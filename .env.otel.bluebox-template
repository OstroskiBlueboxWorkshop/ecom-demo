# ─────────────────────────────────────────────────────────────────────────────
# Bluebox / Dynatrace OpenTelemetry Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.otel (or export these vars in your deployment env).
# Fill in the values from your Bluebox workspace settings.
# NEVER commit a file containing a real token — .env.otel is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# === Required: OTLP endpoint (Bluebox/Dynatrace SaaS ingest) ===
OTEL_EXPORTER_OTLP_ENDPOINT="https://<your-environment-id>.live.dynatrace.com/api/v2/otlp"

# === Required: Authorization header with ingest token ===
# Token type depends on your Dynatrace setup (API token or ingest token).
# Format: "Api-Token <token>" or "Dt0s16.<token-id>.<secret>"
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Api-Token <YOUR_INGEST_TOKEN>"

# === Required: Protocol (must be http/protobuf for Bluebox direct ingest) ===
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"

# === Required: Service identity ===
OTEL_SERVICE_NAME="ecom-store"

# === Required: Resource attributes ===
# service.namespace groups related services; deployment.environment identifies the stage.
# Add cloud.* and vcs.* attributes as applicable (see README).
OTEL_RESOURCE_ATTRIBUTES="service.namespace=ecom-demo,deployment.environment=development"

# === Required: Metrics temporality (Bluebox rejects cumulative) ===
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE="delta"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: VCS attributes (set at build/deploy time for source mapping)
# ─────────────────────────────────────────────────────────────────────────────
# Append to OTEL_RESOURCE_ATTRIBUTES at build time:
#   vcs.repository.url.full=https://github.com/OstroskiBlueboxWorkshop/ecom-demo
#   vcs.ref.head.revision=<git rev-parse HEAD>
#
# Example (in your CI/deploy script):
#   export OTEL_RESOURCE_ATTRIBUTES="service.namespace=ecom-demo,deployment.environment=production,vcs.repository.url.full=https://github.com/OstroskiBlueboxWorkshop/ecom-demo,vcs.ref.head.revision=$(git rev-parse HEAD)"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Cloud resource attributes (when deployed to a cloud provider)
# ─────────────────────────────────────────────────────────────────────────────
# Append to OTEL_RESOURCE_ATTRIBUTES as applicable:
#   cloud.provider=aws|azure|gcp
#   cloud.region=us-east-1
#   cloud.platform=aws_ecs|aws_lambda|azure_vm|gcp_cloud_run|...
#   cloud.account.id=<account-id>
#   cloud.resource_id=<arn-or-resource-id>
