{
  "name": "ecom-otel-demo",
  "version": "1.0.0",
  "description": "Simple e-commerce app ready for OpenTelemetry instrumentation",
  "main": "src/server.js",
  "scripts": {
    "start": "node --require ./src/instrumentation.js src/server.js",
    "start:no-otel": "node src/server.js"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "uuid": "^10.0.0"
  }
}
